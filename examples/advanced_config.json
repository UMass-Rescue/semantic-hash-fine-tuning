{
  "dataset_name": "my-series",
  "image_dir": "/absolute/path/to/images",
  "labels_json": "/absolute/path/to/labels.json",
  "output_dir": "../runs/my-series",
  "model": {"name": "hf-hub:timm/ViT-SO400M-16-SigLIP2-384"},
  "seed": 42,
  "device": "auto",
  "workers": 4,
  "embedding_batch_size": 32,
  "split_fractions": [0.7, 0.15, 0.15],
  "deduplicate_images": false,
  "phash_threshold": 4,
  "clustering": {"enabled": true, "distance_threshold": 0.3, "min_samples": 5},
  "training": {
    "epochs": 9,
    "batch_size": 8,
    "learning_rate": 0.00001,
    "weight_decay": 0.1,
    "warmup_steps": 100,
    "save_every": 3,
    "loss": "siglip",
    "precision": "amp",
    "grad_checkpointing": false
  },
  "evaluation": {"k": [1, 5, 10, 20], "query_chunk_size": 256}
}
